# Public URL
AUTH_PUBLIC_URL=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=authcore

# JWT settings
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

JWT_EMAIL_VERIFICATION_SECRET=dev-email-verification-secret-change-me
JWT_EMAIL_VERIFICATION_EXPIRES_IN=24h

JWT_PASSWORD_RESET_SECRET=dev-password-reset-secret-change-me
JWT_PASSWORD_RESET_EXPIRES_IN=15m

# Argon2
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Global throttle
THROTTLE_DEFAULT_LIMIT=60
THROTTLE_DEFAULT_TTL_MS=60000

# App
PORT=3000
NODE_ENV=development

FRONTEND_ORIGIN=http://localhost:5173
EMAIL_VERIFICATION_RESULT_URL=http://localhost:5173/email-verification-result
PASSWORD_RESET_PAGE_URL=http://localhost:5173/reset-password

# Unverified user lifetime in milliseconds
UNVERIFIED_USER_TTL_MS=604800000

ENABLE_DEMO_NOTIFICATIONS_OUTBOX=true
