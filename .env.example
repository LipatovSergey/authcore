# Public URL
AUTH_PUBLIC_URL=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=authcore

# JWT settings
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

JWT_EMAIL_VERIFICATION_SECRET=dev-email-verification-secret-change-me
JWT_EMAIL_VERIFICATION_EXPIRES_IN=24h

# Argon2
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Global throttle
THROTTLE_DEFAULT_LIMIT=60
THROTTLE_DEFAULT_TTL_MS=60000

# App
PORT=3000
NODE_ENV=development

# Email verificaion
EMAIL_VERIFICATION_TOKEN_TTL_MS=86400000
# Optional
EMAIL_VERIFICATION_RESULT_URL

UNVERIFIED_USER_TTL_MS=604800000
