# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Public backend URL used when generating backend-facing links.
AUTH_PUBLIC_URL=http://localhost:3000

# Frontend origin and redirect targets used by auth flows.
FRONTEND_ORIGIN=http://localhost:5173
EMAIL_VERIFICATION_RESULT_URL=http://localhost:5173/email-verification-result
PASSWORD_RESET_PAGE_URL=http://localhost:5173/reset-password

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=authcore

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

JWT_EMAIL_VERIFICATION_SECRET=dev-email-verification-secret-change-me
JWT_EMAIL_VERIFICATION_EXPIRES_IN=24h

JWT_PASSWORD_RESET_SECRET=dev-password-reset-secret-change-me
JWT_PASSWORD_RESET_EXPIRES_IN=15m

# -----------------------------------------------------------------------------
# Password hashing
# -----------------------------------------------------------------------------

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

THROTTLE_DEFAULT_LIMIT=60
THROTTLE_DEFAULT_TTL_MS=60000

THROTTLE_AUTH_REGISTER_LIMIT=5
THROTTLE_AUTH_REGISTER_TTL_MS=60000

THROTTLE_AUTH_LOGIN_LIMIT=10
THROTTLE_AUTH_LOGIN_TTL_MS=60000

THROTTLE_AUTH_REFRESH_LIMIT=60
THROTTLE_AUTH_REFRESH_TTL_MS=60000

# -----------------------------------------------------------------------------
# Cleanup and retention polices
# -----------------------------------------------------------------------------

# How long unverified user can exist before cleanup
UNVERIFIED_USER_TTL_MS=604800000
# How long inactive email verification tokens are retained before cleanup
EMAIL_VERIFICATION_TOKEN_RETENTION_MS=86400000
# How long inactive password reset tokens are retained before cleanup
PASSWORD_RESET_TOKEN_RETENTION_MS=86400000
# How long inactive refresh tokens are retained before cleanup
REFRESH_TOKEN_RETENTION_MS=604800000

# -----------------------------------------------------------------------------
# Demo features
# -----------------------------------------------------------------------------

ENABLE_DEMO_NOTIFICATIONS_OUTBOX=true
