POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=authcore_test
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

REDIS_HOST=localhost
REDIS_PORT=6379
# Always must be 1 for tests
REDIS_DB=1

REFRESH_COOKIE_SECURE=false

AUTH_PUBLIC_URL=http://localhost:3000

FRONTEND_ORIGIN=http://localhost:5173
EMAIL_VERIFICATION_RESULT_URL=http://localhost:5173/email-verification-result
PASSWORD_RESET_PAGE_URL=http://localhost:5173/reset-password

# Argon2 settings
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# JWT settings
JWT_ACCESS_SECRET=test-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFICATION_SECRET=test-email-verification-secret
JWT_EMAIL_VERIFICATION_EXPIRES_IN=24h
JWT_PASSWORD_RESET_SECRET=test-password-reset-secret
JWT_PASSWORD_RESET_EXPIRES_IN=15m

# CSRF settings
CSRF_SECRET=test-csrf-signing-secret-at-least-32-characters

# Default throttle
THROTTLE_DEFAULT_LIMIT=1000
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_AUTH_REGISTER_LIMIT=1000
THROTTLE_AUTH_REGISTER_TTL_MS=60000

THROTTLE_AUTH_LOGIN_LIMIT=1000
THROTTLE_AUTH_LOGIN_TTL_MS=60000

THROTTLE_AUTH_REFRESH_LIMIT=1000
THROTTLE_AUTH_REFRESH_TTL_MS=60000

UNVERIFIED_USER_TTL_MS=604800000
EMAIL_VERIFICATION_TOKEN_RETENTION_MS=86400000
PASSWORD_RESET_TOKEN_RETENTION_MS=86400000
REFRESH_TOKEN_RETENTION_MS=604800000

ENABLE_DEMO_NOTIFICATIONS_OUTBOX=true
